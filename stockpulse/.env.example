# StockPulse Environment Variables
# Copy this file to .env and fill in your values

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockPulse/1.0

# News API (https://newsapi.org)
NEWS_API_KEY=

# Twitter/X API for CEO signals (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# Email (SendGrid recommended — https://sendgrid.com)
SENDGRID_API_KEY=
EMAIL_FROM=stockpulse@yourdomain.com
EMAIL_TO=abdoultest08@gmail.com

# SMS (Twilio — https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# Optional: OpenAI for enhanced sentiment analysis
OPENAI_API_KEY=
