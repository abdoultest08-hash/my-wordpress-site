# StockPulse Environment Variables
# Copy this file to .env and fill in your values
# On Railway: add these in Project → Variables (not in a .env file)

# Supabase (Settings → Data API in your Supabase project)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx

# Reddit API (https://www.reddit.com/prefs/apps → create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockPulse/1.0

# News API (https://newsapi.org → free tier is fine to start)
NEWS_API_KEY=

# Twitter/X API for CEO signals (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# Email via SendGrid (https://sendgrid.com → free tier: 100 emails/day)
SENDGRID_API_KEY=
EMAIL_FROM=stockpulse@yourdomain.com
EMAIL_TO=abdoultest08@gmail.com

# SMS via Twilio (https://twilio.com → free trial gives ~$15 credit)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
SMS_TO_NUMBER=+1xxxxxxxxxx

# Optional: OpenAI for richer sentiment analysis (gpt-4o-mini is cheap)
OPENAI_API_KEY=
